generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WalletRole {
  user
  worker
  admin
}

enum TransactionType {
  payment
  credit
  platform_fee
  refund
  hold
  release
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentStatus {
  pending
  paid
  worker_credited
  refunded
  failed
}

model Wallet {
  id             String   @id @default(uuid())
  ownerId        String   @map("owner_id")
  role           WalletRole
  balance        Decimal  @default(0.00) @db.Decimal(12, 2)
  pendingBalance Decimal  @default(0.00) @map("pending_balance") @db.Decimal(12, 2)
  totalEarned    Decimal  @default(0.00) @map("total_earned") @db.Decimal(12, 2)
  totalSpent     Decimal  @default(0.00) @map("total_spent") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@unique([ownerId, role])
  @@map("wallets")
}

model Transaction {
  id                String            @id @default(uuid())
  walletId          String            @map("wallet_id")
  workId            String?           @map("work_id")
  razorpayPaymentId String?           @map("razorpay_payment_id")
  type              TransactionType
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("INR")
  status            TransactionStatus @default(pending)
  description       String?
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([workId])
  @@map("transactions")
}

model Payment {
  id                 String        @id @default(uuid())
  workId             String        @map("work_id")
  userId             String        @map("user_id")
  workerId           String        @map("worker_id")
  razorpayOrderId    String?       @unique @map("razorpay_order_id")
  razorpayPaymentId  String?       @unique @map("razorpay_payment_id")
  amount             Decimal       @db.Decimal(12, 2)
  platformFee        Decimal       @default(0.00) @map("platform_fee") @db.Decimal(12, 2)
  workerPayout       Decimal       @default(0.00) @map("worker_payout") @db.Decimal(12, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(pending)
  workCompletedAt    DateTime?     @map("work_completed_at")
  payoutScheduledAt  DateTime?     @map("payout_scheduled_at")
  payoutCompletedAt  DateTime?     @map("payout_completed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  platformEarnings PlatformEarning[]

  @@index([workId])
  @@index([userId])
  @@index([workerId])
  @@index([razorpayOrderId])
  @@map("payments")
}

model PlatformEarning {
  id          String   @id @default(uuid())
  paymentId   String   @map("payment_id")
  workId      String   @map("work_id")
  feeAmount   Decimal  @map("fee_amount") @db.Decimal(12, 2)
  currency    String   @default("INR")
  collectedAt DateTime @default(now()) @map("collected_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("platform_earnings")
}
